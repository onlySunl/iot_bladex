<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>nvr-platform</artifactId>
        <version>4.9.0.RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nvr-protocol</artifactId>
    <packaging>pom</packaging>
    <name>nvr-protocol</name>
    <description>
        聚合所有摄像头、流媒体、车载国标底层通信实现模块，统一管控全部协议子模块版本；
        包含公共协议基础、海康 ISUP、QS 球机、ZLM 流媒体，预留 GB28181/大华/ONVIF/JT1078 扩展模块。
    </description>

    <properties>
        <module.name>nvr.protocol</module.name>
    </properties>

    <!-- 子模块引入无需写 version，由 nvr-platform 父 POM 统一管理 -->

    <!-- ==================== 协议子模块清单 ==================== -->
    <modules>
        <module>nvr-protocol-common</module>        <!-- 协议公共基础、报文解析、网络工具基类 -->
        <module>nvr-protocol-qs</module>           <!-- QS 球机协议底层实现 -->
        <module>nvr-protocol-zlm</module>          <!-- ZLMediaKit 流媒体底层实现 -->
        <module>nvr-protocol-haikang-isup</module> <!-- 海康 ISUP 私有协议底层实现 -->
        <!-- 以下模块待开发 -->
        <!--<module>nvr-protocol-gb28181</module>-->
        <!--<module>iot-protocol-haikang</module>-->
        <!--<module>nvr-protocol-dahua</module>-->
        <!--<module>nvr-protocol-onvif</module>-->
        <!--<module>nvr-protocol-jt1078</module>-->
    </modules>
</project>

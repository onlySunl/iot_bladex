<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：nvr-api聚合模块，version必须字面量，禁止变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>nvr-api</artifactId>
        <version>4.2.0.RELEASE</version>
        <!-- 本地优先加载上层父pom，无需远程仓库拉取 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nvr-api-haikang</artifactId>
    <name>nvr-api-haikang</name>
    <description>封装海康NVR、摄像头设备对接Feign远程接口、DTO、入参出参实体定义</description>

    <properties>
        <!-- 日志、链路追踪模块唯一标识 -->
        <module.name>nvr.api.haikang</module.name>
        <!-- 统一源码、报告输出编码，避免Windows/Linux中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- ===================== NVR项目内部公共依赖（版本顶层统一管控） ===================== -->
        <!-- NVR业务公共工具、常量、基础DTO、异常封装 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>nvr-common</artifactId>
        </dependency>
        <!-- Blade底层通用工具、全局基础注解、统一返回体 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
        </dependency>
    </dependencies>
</project>
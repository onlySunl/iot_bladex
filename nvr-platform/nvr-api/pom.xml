<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>nvr-platform</artifactId>
        <version>4.9.0.RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nvr-api</artifactId>
    <packaging>pom</packaging>
    <name>nvr-api</name>
    <description>
        统一聚合所有摄像头、流媒体、车载国标 Feign 接口定义模块，
        集中管控全部 api 子模块版本，对外提供统一远程调用接口 DTO 与 Feign 定义。
    </description>

    <properties>
        <module.name>nvr.api</module.name>
    </properties>

    <!-- 子模块引入无需写 version，由 nvr-platform 父 POM 统一管理 -->

    <!-- ==================== 各协议 Feign 接口子模块清单 ==================== -->
    <modules>
        <module>nvr-api-dahua</module>        <!-- 大华 SDK 接口 -->
        <module>nvr-api-gb28181</module>      <!-- GB28181 国标 SIP 接口 -->
        <module>nvr-api-haikang</module>      <!-- 海康标准 SDK 接口 -->
        <module>nvr-api-jt1078</module>       <!-- JT1078 车载视频部标 -->
        <module>nvr-api-onvif</module>        <!-- ONVIF 通用设备协议 -->
        <module>nvr-api-haikang-isup</module> <!-- 海康 ISUP 私有协议 -->
        <module>nvr-api-qs</module>           <!-- QS 球机协议 -->
        <module>nvr-api-zlm</module>          <!-- ZLM 流媒体对接 -->
    </modules>
</project>

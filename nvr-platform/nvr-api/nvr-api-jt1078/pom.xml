<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：nvr-api聚合模块，parent版本必须固定字面量，禁止使用变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>nvr-api</artifactId>
        <version>4.9.0.RELEASE</version>
        <!-- 本地优先读取上层聚合pom，减少远程仓库拉取，提升编译速度 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nvr-api-jt1078</artifactId>
    <name>nvr-api-jt1078</name>
    <description>封装JT1078车载视频协议设备远程调用Feign接口、报文DTO、请求响应实体类</description>

    <properties>
        <!-- 日志、链路追踪区分模块唯一标识 -->
        <module.name>nvr.api.jt1078</module.name>
        <!-- 统一源码与报告输出编码，避免Windows/Linux中文注释乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- ===================== NVR项目内部公共依赖（版本由顶层统一管控，无需指定version） ===================== -->
        <!-- NVR业务公共工具、常量、基础DTO、通用异常封装 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>nvr-common</artifactId>
        </dependency>
        <!-- Blade底层通用工具、全局基础注解、统一返回体封装 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
        </dependency>
    </dependencies>
</project>
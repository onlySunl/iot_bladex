<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>iot-link</artifactId>
        <groupId>org.springblade</groupId>
        <version>4.9.0.RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>iot-link-server</artifactId>
    <name>${project.artifactId}</name>
    <description>设备集成服务-启动模块</description>

    <dependencies>
        <!-- IoT Link Controller -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>iot-link-controller</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- IoT Link Boot Impl -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>iot-link-boot-impl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Blade Boot -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-boot</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

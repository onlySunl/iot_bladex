<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 顶层总聚合父工程，版本字面量不可使用变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot-platform</artifactId>
        <version>4.2.0.RELEASE</version>
        <!-- 本地优先加载父pom，加速多模块编译 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>iot-components</artifactId>
    <packaging>pom</packaging>
    <name>iot-components</name>
    <description>
        聚合各类物联网设备接入协议组件；
        iot-component-core 为所有协议公共基础包，MQTT/TCP/UDP/HTTP/CoAP/Modbus/EMQX 均依赖 core。
    </description>

    <properties>
        <!-- 链路追踪、日志模块唯一标识 -->
        <module.name>iot.components</module.name>
        <!-- 统一文件编码，避免Windows/Linux中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- 
        依赖版本由父POM (iot-platform) 统一管理，此处不再重复声明 dependencyManagement。
        子模块直接引用 iot-component-core 等内部组件时，版本自动从父POM继承。
    -->

    <!-- 聚合层全局公共依赖，所有协议子模块自动继承 -->
    <dependencies>
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
        </dependency>
        <!-- 1.Vert.x 高性能事件驱动框架（版本顶层统一管控） -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-mqtt</artifactId>
        </dependency>

        <!-- 2.Spring 基础上下文 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- 3.通用工具类 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- 4.仅编译期注解依赖（provided，不传递运行时，解决javax.annotation冲突） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- 协议子模块清单，每行标注业务用途 -->
    <modules>
        <module>iot-component-core</module>        <!-- 协议公共抽象、工具、基类 -->
        <module>iot-component-mqtt</module>         <!-- 标准MQTT设备接入 -->
        <module>iot-component-emqx</module>         <!-- EMQX Broker专用客户端 -->
        <module>iot-component-tcp</module>          <!-- TCP透传工业设备 -->
        <module>iot-component-http</module>         <!-- HTTP/HTTPS设备上报 -->
        <module>iot-component-udp</module>          <!-- 低功耗UDP短报文 -->
        <module>iot-component-modbus-custom</module><!-- Modbus RTU/TCP工业协议 -->
        <module>iot-component-coap</module>         <!-- CoAP低功耗物联网协议 -->
    </modules>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：iot-components协议聚合模块，版本字面量禁止使用变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot-components</artifactId>
        <version>4.9.0.RELEASE</version>
        <!-- 本地优先加载上层聚合pom，减少远程仓库请求 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>iot-component-coap</artifactId>
    <name>iot-component-coap</name>
    <description>基于Californium实现CoAP物联网协议接入组件，支持窄带、低功耗设备上报、下发指令</description>

    <properties>
        <!-- 日志/链路追踪模块唯一标识 -->
        <module.name>iot.component.coap</module.name>
        <!-- CoAP协议库统一版本，后续升级仅修改此处 -->
        <californium.version>2.0.0-M7</californium.version>
        <!-- 全局统一文件编码，解决Windows/Linux中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- ===================== IOT内部公共组件 ===================== -->
        <!-- 协议组件公共抽象、工具、基类 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>iot-component-core</artifactId>
        </dependency>
        <!-- Feign远程API接口定义，与业务模块互通实体/接口 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>module-iot-api</artifactId>
        </dependency>

        <!-- ===================== Vertx高性能事件驱动框架 ===================== -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
        </dependency>

        <!-- ===================== Californium CoAP协议三方依赖 ===================== -->
        <dependency>
            <groupId>org.eclipse.californium</groupId>
            <artifactId>californium-core</artifactId>
            <version>${californium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.californium</groupId>
            <artifactId>element-connector</artifactId>
            <version>${californium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.californium</groupId>
            <artifactId>scandium</artifactId>
            <version>${californium.version}</version>
        </dependency>
    </dependencies>
</project>
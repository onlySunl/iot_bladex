<?xml version="1.0" encoding="UTF-8"?>
<!--
    ========================================================================
    IoT 物联网平台 - 聚合工程
    ========================================================================
    职责: 管理 IoT 平台下的 JAR 包版本及引用
    包含: 设备集成、MQTT Broker、消息队列、规则引擎、时序数据等
    ========================================================================
    项目结构:
    ├── iot-entity/          # 实体模块层
    ├── iot-broker/          # MQTT Broker 服务层
    ├── iot-link/            # 设备集成服务层
    ├── iot-mqs/             # 消息队列服务层
    ├── iot-rule/            # 规则引擎服务层
    ├── iot-sdk/             # SDK 模块
    ├── iot-tds/             # 时序数据服务层
    ├── iot-common/          # 公共模块
    └── iot-model/           # 模型模块
    ========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot_bladex</artifactId>
        <version>4.9.0.RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>iot-platform</artifactId>
    <packaging>pom</packaging>
    <name>iot-platform</name>
    <description>IoT 物联网平台聚合工程 - 管理 IoT 相关依赖</description>

    <!-- ==================== IoT 平台版本属性 ==================== -->
    <properties>
        <iot-platform.version>4.9.0.RELEASE</iot-platform.version>
        
        <!-- 数据库相关 -->
        <mysql.version>8.0.33</mysql.version>
        <druid.version>1.2.20</druid.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        
        <!-- 缓存相关 -->
        <redisson.version>3.24.3</redisson.version>
        
        <!-- 消息队列 -->
        <rocketmq.version>2.2.3</rocketmq.version>
        <kafka.version>3.3.15</kafka.version>
        
        <!-- 工具类 -->
        <hutool.version>5.8.22</hutool.version>
        <easyexcel.version>3.3.3</easyexcel.version>
        <oshi.version>6.4.0</oshi.version>
        
        <!-- 协议相关 -->
        <netty.version>4.1.100.Final</netty.version>
        <mqtt-client.version>1.2.5</mqtt-client.version>
        
        <!-- 脚本引擎 -->
        <groovy.version>4.0.15</groovy.version>
        
        <!-- 状态机 -->
        <cola-statemachine.version>5.0.0</cola-statemachine.version>
    </properties>

    <!-- ==================== 子模块列表 ==================== -->
    <modules>
        <!-- 实体模块层 -->
        <module>iot-entity</module>
        <!-- MQTT Broker 服务层 -->
        <module>iot-broker</module>
        <!-- 设备集成服务层 -->
        <module>iot-link</module>
        <!-- 消息队列服务层 -->
        <module>iot-mqs</module>
        <!-- 规则引擎服务层 -->
        <module>iot-rule</module>
        <!-- SDK 模块 -->
        <module>iot-sdk</module>
        <!-- 时序数据服务层 -->
        <module>iot-tds</module>
        <!-- 公共模块 -->
        <module>iot-common</module>
        <!-- 模型模块 -->
        <module>iot-model</module>
    </modules>

    <!-- ==================== IoT 平台依赖版本管理 ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- ==================== 1. IoT 实体模块 ==================== -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-entity-link</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-entity-broker</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-entity-mqs</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-entity-rule</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-entity-tds</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-entity-common</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>

            <!-- ==================== 2. IoT 业务模块 ==================== -->
            <!-- 设备集成 -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-link-biz</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-link-api</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-link-boot-impl</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-link-cloud-impl</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            
            <!-- 规则引擎 -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-rule-biz</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-rule-api</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-rule-boot-impl</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-rule-cloud-impl</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            
            <!-- MQTT Broker -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-broker-biz</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-broker-api</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            
            <!-- 消息队列 -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-mqs-biz</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-mqs-api</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            
            <!-- 时序数据 -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-tds-biz</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-tds-api</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            
            <!-- SDK -->
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-sdk-core</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springblade</groupId>
                <artifactId>iot-simple-sdk</artifactId>
                <version>${iot-platform.version}</version>
            </dependency>

            <!-- ==================== 3. IoT 数据库相关 ==================== -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- ==================== 4. IoT 缓存相关 ==================== -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ==================== 5. IoT 消息队列 ==================== -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>${kafka.version}</version>
            </dependency>

            <!-- ==================== 6. IoT 工具类 ==================== -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <!-- ==================== 7. IoT 网络协议 ==================== -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.mqttv5.client</artifactId>
                <version>${mqtt-client.version}</version>
            </dependency>

            <!-- ==================== 8. IoT 脚本引擎 ==================== -->
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy-json</artifactId>
                <version>${groovy.version}</version>
            </dependency>

            <!-- ==================== 9. IoT 状态机 ==================== -->
            <dependency>
                <groupId>com.alibaba.cola</groupId>
                <artifactId>cola-component-statemachine</artifactId>
                <version>${cola-statemachine.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== 构建配置 ==================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- ==================== 发布配置 ==================== -->
    <distributionManagement>
        <repository>
            <id>blade-release</id>
            <name>Release Repository</name>
            <url>http://nexus.bladex.vip/repository/bladex-releases/</url>
        </repository>
        <snapshotRepository>
            <id>blade-snapshots</id>
            <name>Snapshot Repository</name>
            <url>http://nexus.bladex.vip/repository/bladex-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>

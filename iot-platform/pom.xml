<?xml version="1.0" encoding="UTF-8"?>
<!--
    ========================================================================
    IoT 物联网平台 - 聚合工程
    ========================================================================
    职责: 管理 IoT 平台下的 JAR 包版本及引用
    包含: 设备集成、MQTT Broker、消息队列、规则引擎、时序数据等
    ========================================================================
    项目结构:
    ├── iot-entity/          # 实体模块层
    ├── iot-broker/          # MQTT Broker 服务层
    ├── iot-link/            # 设备集成服务层
    ├── iot-mqs/             # 消息队列服务层
    ├── iot-rule/            # 规则引擎服务层
    ├── iot-sdk/             # SDK 模块
    ├── iot-tds/             # 时序数据服务层
    ├── iot-common/          # 公共模块
    └── iot-model/           # 模型模块
    ========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot_bladex</artifactId>
        <version>4.9.0.RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>iot-platform</artifactId>
    <packaging>pom</packaging>
    <name>iot-platform</name>
    <description>IoT 物联网平台聚合工程 - 管理 IoT 相关依赖</description>

    <!-- ==================== IoT 平台版本属性 ==================== -->
    <properties>
        <iot-platform.version>4.9.0.RELEASE</iot-platform.version>
        
        <!-- 数据库相关 -->
        <mysql.version>8.0.33</mysql.version>
        <druid.version>1.2.20</druid.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        
        <!-- 缓存相关 -->
        <redisson.version>3.24.3</redisson.version>
        
        <!-- 消息队列 -->
        <rocketmq.version>2.2.3</rocketmq.version>
        <kafka.version>3.9.2</kafka.version>
        <spring-kafka.version>3.3.0</spring-kafka.version>
        
        <!-- 工具类 -->
        <hutool.version>5.8.44</hutool.version>
        <easyexcel.version>3.3.3</easyexcel.version>
        <oshi.version>6.4.0</oshi.version>
        
        <!-- 协议相关 -->
        <netty.version>4.1.100.Final</netty.version>
        <mqtt-client.version>1.2.5</mqtt-client.version>
        
        <!-- 脚本引擎 -->
        <blade.groovy.version>4.0.30</blade.groovy.version>
        
        <!-- 状态机 -->
        <cola-statemachine.version>5.0.0</cola-statemachine.version>
    </properties>

    <!-- ==================== 子模块列表 ==================== -->
    <modules>
        <!-- ===== 实体层（无内部依赖） ===== -->
        <module>iot-model</module>
        <module>iot-common</module>
        <module>iot-entity</module>

        <!-- ===== 基础服务层 ===== -->
        <module>iot-base</module>
        <module>iot-message</module>
        <module>iot-file-sdk</module>

        <!-- ===== 业务服务层 ===== -->
        <module>iot-broker</module>
        <module>iot-link</module>
        <module>iot-mqs</module>
        <module>iot-rule</module>
        <module>iot-tds</module>

        <!-- ===== SDK ===== -->
        <module>iot-sdk</module>

        <!-- ===== Starter 聚合（最后） ===== -->
        <module>iot-platform-starter</module>
    </modules>


<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：iot-entity实体聚合模块，version必须字面量，禁止变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot-entity</artifactId>
        <version>4.2.0.RELEASE</version>
        <!-- 本地快速寻址父pom，加速构建 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>iot-entity-component</artifactId>
    <name>iot-entity-component</name>
    <description>存放MQTT/Modbus/CoAP/TCP/UDP等各类协议组件DO、DTO、VO、数据库注解实体</description>

    <properties>
        <!-- 日志链路、Spring环境识别模块标识 -->
        <module.name>iot.entity.component</module.name>
        <!-- 统一源码文件编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 1. Blade底层通用工具、基础DTO、常量、序列化工具 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 2. Lombok编译期生成get/set/构造，运行时无需依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 3. AutoTable自动建表数据库注解，仅编译期生效 -->
        <dependency>
            <groupId>com.tangzc</groupId>
            <artifactId>auto-table-annotation</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
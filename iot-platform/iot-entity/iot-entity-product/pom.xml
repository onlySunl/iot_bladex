<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：iot-entity聚合模块，version必须写死字面量，禁止变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot-entity</artifactId>
        <version>4.9.0.RELEASE</version>
        <!-- 本地优先读取上层iot-entity/pom.xml，无需远程仓库拉取 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>iot-entity-product</artifactId>
    <name>iot-entity-product</name>
    <description>存放产品DO、产品DTO、分页VO、数据库注解实体</description>

    <properties>
        <!-- 日志、链路追踪模块唯一标识 -->
        <module.name>iot.entity.product</module.name>
        <!-- 统一源码、报告输出编码，防止中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 1. Blade基础工具、常量、通用DTO，仅编译依赖 -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 2. Lombok编译期生成get/set/构造器，运行时不传递依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 3. AutoTable自动建表数据库注解，仅编译阶段生效 -->
        <dependency>
            <groupId>com.tangzc</groupId>
            <artifactId>auto-table-annotation</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
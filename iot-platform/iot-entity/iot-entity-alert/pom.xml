<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：iot-entity 实体聚合模块，version必须字面量，禁止${}变量 -->
    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>iot-entity</artifactId>
        <version>4.2.0.RELEASE</version>
        <!-- 本地直接寻址父pom，不用拉仓库 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>iot-entity-alert</artifactId>
    <name>IoT-告警实体模块</name>
    <description>存放告警、短信、语音通知相关DO、DTO、VO实体类</description>

    <properties>
        <!-- 模块唯一标识，用于日志/链路区分 -->
        <module.name>iot.entity.alert</module.name>
        <!-- 全局版本统一复用，子模块依赖可直接${project.version} -->
        <project.version>4.2.0.RELEASE</project.version>
    </properties>

    <dependencies>
        <!-- Blade基础工具、常量、通用DTO -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Lombok编译期注解，打包不输出 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- AutoTable数据库建表注解，仅编译使用 -->
        <dependency>
            <groupId>com.tangzc</groupId>
            <artifactId>auto-table-annotation</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
<?xml version="1.0" encoding="UTF-8"?>
<!--
    blade-public: 公共核心模块聚合
    管理所有 blade-core-* 子模块，提供基础框架能力
-->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>iot_bladex</artifactId>
        <groupId>org.springblade</groupId>
        <version>4.9.0.RELEASE</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>blade-public</artifactId>
    <name>${project.artifactId}</name>
    <description>公共核心模块聚合 - 管理所有 blade-core-* 子模块</description>
    <packaging>pom</packaging>

    <modules>
        <!-- ===== 基础层（无内部依赖） ===== -->
        <module>blade-core-annotation</module>
        <module>blade-core-basic</module>

        <!-- ===== 数据层 ===== -->
        <module>blade-core-cache</module>
        <module>blade-core-database</module>
        <module>blade-core-tds</module>

        <!-- ===== 中间件层 ===== -->
        <module>blade-core-kafka</module>
        <module>blade-core-rocketmq</module>
        <module>blade-core-fastdfs</module>

        <!-- ===== 框架层 ===== -->
        <module>blade-core-validator</module>
        <module>blade-core-mvc</module>
        <module>blade-core-uid</module>
        <module>blade-core-easyexcel</module>
        <module>blade-core-protocol</module>
        <module>blade-core-dynamic-tp</module>
        <module>blade-core-groovy</module>
        <module>blade-core-condition</module>
        <module>blade-core-dinger</module>

        <!-- ===== 桥接层 ===== -->
        <module>blade-core-databridge</module>

        <!-- ===== 开放平台 ===== -->
        <module>open-exp-client-api</module>
        <module>open-plugin-manager</module>

        <!-- ===== AI 集成 ===== -->
        <module>blade-core-chatgpt</module>
    </modules>

    <dependencies>
        <!-- 公共依赖由子模块各自管理 -->
    </dependencies>
</project>
